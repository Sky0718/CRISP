cff-version: 1.2.0
message: "Please cite CRISP and the accompanying research article when using this code."
title: "CRISP: Cancer-gene Ranking Interpretation with Screen Profiles"
type: software
authors:
  - family-names: Guan
    given-names: Tianyi
    orcid: "https://orcid.org/0009-0005-3379-6708"
license:
